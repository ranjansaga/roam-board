# Roam Board — environment configuration (NO secrets here; see Constitution Principle V)
#
# The traveler's own Gemini API key is BYOK: entered in the app UI and stored on-device,
# NOT set here. These vars only configure server-side behavior.

# Default Gemini model id used when the traveler does not override it in Settings.
# gemini-2.0-flash has no "thinking" pass, so it is fast and avoids timeouts. Newer 3.x Flash
# models are higher quality but run a reasoning pass by default (much slower for itineraries);
# override in Settings only if you accept the added latency.
GEMINI_MODEL=gemini-2.0-flash

# Hard timeout (ms) for a single AI generation request (Constitution Principle IV).
# Generation is fast with thinking disabled; this is a generous backstop, not the expected wait.
AI_REQUEST_TIMEOUT_MS=60000
